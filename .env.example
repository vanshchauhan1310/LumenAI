# Supabase (managed Postgres). Create a free project at https://supabase.com,
# then in Supabase Dashboard -> SQL Editor run supabase_schema.sql (once) to
# create the tables. Finally grab credentials from Project Settings -> API:
#   - Project URL            -> SUPABASE_URL
#   - service_role key       -> SUPABASE_SERVICE_ROLE_KEY (server-only secret,
#     bypasses row-level security — never expose it to browsers/clients)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Signs platform session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=

# 32-byte key (base64-encoded) used to encrypt Tableau PATs and LLM API keys
# at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Tableau REST API version used for all sites (adjust to your pod's supported version)
TABLEAU_API_VERSION=3.24

# Optional: shared Redis cache (leave unset to use in-memory cache only).
# Strongly recommended for production — multi-tier caching (memory + Redis)
# keeps datasource/workbook lists and metadata warm across restarts and
# processes, which is the largest response-time win. Free tiers: Redis Cloud,
# Upstash, or a self-hosted redis. Redis is optional at runtime — the server
# degrades gracefully to in-memory only if this is unset or unreachable.
# REDIS_URL=redis://localhost:6379

PORT=3000

# Never commit a real value here — this file is a template. Copy it to
# .env (already gitignored) and fill in real secrets there instead.
