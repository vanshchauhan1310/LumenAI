# Copy this file to .env.production (gitignored, never committed) and fill in
# the real values from Supabase: Project Settings -> API. These are used by
# scripts/open-prod-studio.ps1 (Supabase Table Editor / SQL editor equivalent
# of the old Prisma Studio workflow).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
